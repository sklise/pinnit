{
  "manifest_version": 3,
  "name": "Pinnit",
  "version": "1.0.0",
  "description": "Automatically locks pinned tabs to their current domain to prevent accidental navigations.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pinnit"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
