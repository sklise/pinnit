{
  "manifest_version": 3,
  "name": "Pinnit",
  "version": "1.0.0",
  "description": "Locks your pinned tabs to their active domains. Opens external link navigations in new tabs automatically.",
  "homepage_url": "https://github.com/sklise/pinnit",
  "minimum_chrome_version": "105",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webNavigation",
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pinnit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
